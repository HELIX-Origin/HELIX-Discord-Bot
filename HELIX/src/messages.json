  "events": {
    "ready": "🧬 HELIX is online! Connected as: {tag} ({id}) serving {guildCount} server(s).",
    "guild_create": "📥 Joined guild: {name} ({id}) — {memberCount} members.",
    "guild_delete": "📤 Left guild: {name} ({id})."
  },
  "logs": {
    "command": "Command '{name}' executed by {user} in {guild}",
    "ticket": "Ticket thread {thread} created by {user} in {guild}",
    "plugin": "Plugin '{id}' v{version} loaded from {repo}"
  }
}
