{
  "name": "helix-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Local development & test toolchain for the HELIX Discord bot (tests import from HELIX/src). The bot itself is fully self-contained under HELIX/.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "build": "npm --prefix HELIX run build",
    "prestart": "npm run build",
    "start": "npm --prefix HELIX start",
    "dev": "npm --prefix HELIX run dev",
    "typecheck": "npm --prefix HELIX run typecheck"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
