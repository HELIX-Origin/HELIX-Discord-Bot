# ============================================================
# HELIX Discord Bot & Dashboard — Environment Configuration
# ============================================================
# This is the template for the bot's own .env file at HELIX/.env.
#
# The variables below configure the Discord bot, web dashboard,
# and HTTP server.

# ------------------------------------------
# Built-in Discord Bot & NextAuth Dashboard
# ------------------------------------------
# Primary server port for Discord bot callback and health checks (defaults to 5000).
# The web dashboard automatically runs on an adjacent port in the same range (PORT + 1, e.g. 5001).
PORT=5000

# Discord Application & Bot Credentials
DISCORD_TOKEN="[ENCRYPTION_KEY]"
DISCORD_CLIENT_ID="[OAUTH_CLIENT_ID]"
DISCORD_CLIENT_SECRET="[OAUTH_CLIENT_SECRET]"

# Discord OAuth2 Callback URL (optional — defaults to NEXTAUTH_URL)
# Only set this if you need to override the auto-detected local callback.
# DISCORD_CALLBACK_URL=http://localhost:5000/api/auth/callback/discord

# NextAuth Dashboard URLs (optional — defaults to http://localhost:<DASHBOARD_PORT>)
# Set NEXTAUTH_URL to your public domain when hosting behind a reverse proxy (e.g. https://bot.yourdomain.com).
# NEXTAUTH_URL=http://localhost:5001
# Note: NEXTAUTH_INTERNAL_URL is automatically derived as http://localhost:<DASHBOARD_PORT> in memory.
NEXTAUTH_SECRET="[OAUTH_CLIENT_SECRET]"
NEXT_PUBLIC_INVITE_URL="https://discord.com/api/oauth2/authorize?client_id=yourclientid&permissions=8&scope=bot"

# Bot Owner ID (a single Discord user ID allowed to use bot-owner commands)
BOT_OWNER_ID=

# ------------------------------------------
# HELIX Bot System Configuration
# ------------------------------------------
HELIX_LOG_LEVEL=info
HELIX_DISABLE_TELEMETRY=true
HELIX_DEFAULT_GIT_PLATFORM=github
