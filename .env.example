# HELIX Discord Bot self-hosting configuration.
# The app reads it automatically via `npm start` (node --env-file-if-exists=.env).

# Internal bind address and port for both the web dashboard and Discord bot endpoints.
# (e.g. 127.0.0.1:3131 or 0.0.0.0:3131). Defaults to 127.0.0.1:3131.
INTERNAL_URL=127.0.0.1:3131

# Optional port overrides (fall back to INTERNAL_URL when set): PORT is the
# generic override, DISCORD_PORT is the Discord-bot specific alias.
# HOST=0.0.0.0
# PORT=
# DISCORD_PORT=

# Public URL for the service when accessed via domain name or custom host (e.g. https://your.domain).
# Used for generating OAuth redirect callbacks.
# Leave empty if you want the app to auto-derive it from INTERNAL_URL (e.g. http://127.0.0.1:3131).
PUBLIC_URL=

# Repository & User-Agent identification for self-hosted instances.
# Used in Discord REST API requests, feed fetchers, and dashboard links.
REPO_URL=https://github.com/HELIX-Origin/HELIX-Discord-Bot
USER_AGENT=
# FEED_USER_AGENT=     # (Optional alias for USER_AGENT, used by feed fetchers)
# DISCORD_USER_AGENT=  # (Optional alias for USER_AGENT, used by Discord REST/OAuth)

# Log level: debug | info | warn | error
LOG_LEVEL=info

# HTTP request timeout in milliseconds.
REQUEST_TIMEOUT_MS=15000

# Discord bot credentials (Required for bot functionality).
# The bot starts automatically when DISCORD_TOKEN is set.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord OAuth callback URL (RECOMMENDED: always set this explicitly).
# This is the exact URI registered under Discord Developer Portal > Your App >
# OAuth2 > General > "Redirects", e.g. https://your.domain/api/auth/callback/discord
# When set, Discord login always returns to this URL — it is never derived from
# INTERNAL_URL or PUBLIC_URL, preventing proxy/IP mix-ups.
# Leave empty to auto-derive it from PUBLIC_URL (or INTERNAL_URL as a fallback).
DISCORD_CALLBACK_URL=https://your.domain/api/auth/callback/discord

# Discord Bot Invite & Authorization URL.
# Replace `your_client_id` with your actual Discord application client ID from
# the Discord Developer Portal. Users open this link to add the bot to their server.
DISCORD_REDIRECT_URL=https://discord.com/oauth2/authorize?client_id=your_client_id&permissions=8&integration_type=0&scope=bot+applications.commands

# (Optional) Override the Discord REST API base URL, e.g. for a proxy.
# DISCORD_API_BASE_URL=https://discord.com/api/v10

# --- Optional: Thread Delivery ---
# Optional per-server feature: when enabled, each feed delivers into its OWN
# dedicated thread auto-created in the feed's configured text channel
# (one thread per feed, named after the feed). Threads are kept open with
# keepalive pings and rotate into a fresh thread when they grow large.
#
# Per-server enabling is handled from the dashboard Guild Admin tab
# ("Feed Delivery" card) or via the channels/settings API (threadsEnabled).
# THREADS_ENABLED (below, in the Feature Flags section) is the global
# master switch: set it to false to disable thread delivery everywhere.
THREADS_ENABLED=true

# Keepalive: polls open feed threads and posts a small message shortly before
# Discord would auto-archive them (grace window), keeping them alive.
THREAD_KEEPALIVE_ENABLED=true
THREAD_KEEPALIVE_INTERVAL_MS=21600000
THREAD_KEEPALIVE_GRACE_MS=86400000

# Rotate a feed's thread after this many delivered entries: the large thread is
# archived (closed) and a fresh thread is opened in its place.
THREAD_MAX_MESSAGES=100

# --- Optional: Dashboard Theme & Landing Page ---
# Dashboard theme: glassmorphism | dark | light | cyberpunk | dracula | nord | emerald (default: dark).
DASHBOARD_THEME=dark

# Accent color scheme for any theme: default | cyan | purple | blue | emerald | rose | amber | indigo | crimson | teal | sunset.
DASHBOARD_COLOR_SCHEME=default

# --- Database ---
# SQLite connection string (DB_URI). SQLite is the only supported engine.
# Example:
#   sqlite://./data/database.sqlite  (or sqlite:./data/database.sqlite)
# Defaults to SQLite file in SQLITE_DATA directory.
DB_URI=sqlite://./data/database.sqlite

# Directory where the SQLite database file is stored (used when DB_URI is not set or for sqlite:).
SQLITE_DATA=./data

# YouTube API credentials (for YouTube Stream Alerts)
# YouTube Data API v3 API Key -- (optional)
# YouTube Data API v3 Client ID/Secret -- (for YouTube stream/upload alerts)
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Twitch API credentials (for Twitch Stream Alerts)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Reddit Feeds (optional but REQUIRED for the Reddit tab to function) ---
# Reddit feed features (subscribing to subreddits, checking subreddit content
# ratings) need an authenticated Reddit session cookie file. Resolution order:
#   1. REDDIT_COOKIES_FILE (absolute or relative path to a cookies file),
#   2. a `cookies.json` file at the repo root (PREFERRED format — export via a
#      browser extension such as "Get Cookies Locally"),
#   3. a `cookies.txt` file at the repo root (Netscape-format fallback).
# Without one of these files the Reddit tab and /reddit commands are disabled.
# SECURITY: please use a dedicated ALT Reddit account for this cookie file to
# avoid possible bans on your primary Reddit account. Never commit it.
# REDDIT_COOKIES_FILE=

# --- Global Feature Flags ---
# Most features default to ENABLED when the key is unset. Set to 'false' to disable
# the feature entirely: slash commands not registered, dashboard pages hidden,
# and internal wiring not started.
FEEDS_ENABLED=true
STREAM_ALERTS_ENABLED=true

# --- Feed Subscription Limits (optional) ---
# Per-tab feed subscription caps as a CSV of `category=number` pairs.
# Supported categories: rss, reddit, freegames, streamalerts.
# Set a category to '0' to make that tab unlimited.
# NOTE: rss=10,reddit=10 are the built-in defaults; this key overrides them.
# FEED_CATEGORY_LIMITS=rss=10,reddit=10
THREADS_ENABLED=true
ADMINISTRATION_ENABLED=true
DASHBOARD_ENABLED=true
ADMIN_PANEL_ENABLED=true

# Set to false to disable the landing page at "/" and redirect straight to /dashboard instead.
LANDING_PAGE_ENABLED=true
