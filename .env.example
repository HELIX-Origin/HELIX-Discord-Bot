# ==========================================
# HELIX CLI - Environment Configuration
# ==========================================
# Note: HELIX CLI automatically attempts to discover authenticated credentials
# directly from installed clients (GitHub CLI 'gh', GitLab CLI 'glab', Antigravity, Open Code).
# The variables below serve as fallbacks when client discovery is not available.

# ------------------------------------------
# AI Provider Credentials (Fallback)
# ------------------------------------------

# Google Antigravity / Gemini API Key
# Used when Antigravity local client session is not detected
ANTIGRAVITY_API_KEY=
GEMINI_API_KEY=

# Open Code Go / Zen API Key
# Used when Open Code local configuration is not detected
OPENCODE_API_KEY=

# GitHub Copilot Token / API Key
# Used when GitHub CLI (gh auth token) or Copilot client is not detected
GITHUB_TOKEN=
COPILOT_API_KEY=

# ------------------------------------------
# Code Hosting Platform Tokens (Fallback)
# ------------------------------------------

# GitLab Personal Access Token
# Used when GitLab CLI (glab) is not installed or authenticated
GITLAB_TOKEN=

# Bitbucket Credentials
# Used for Bitbucket repository and pipeline management
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=

# ------------------------------------------
# Built-in Discord Bot & NextAuth Dashboard Configuration
# ------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:5000
NEXT_PUBLIC_INVITE_URL="https://discord.com/api/oauth2/authorize?client_id=yourclientid&permissions=8&scope=bot"
DISCORD_GUILD_ID=

# NextAuth Dashboard URLs
# Note: The dashboard automatically attaches and binds the server's port to NEXTAUTH_INTERNAL_URL (e.g. :5000)
# ensuring no port collisions occur with the bot.
NEXTAUTH_URL=http://localhost:5000
NEXTAUTH_INTERNAL_URL=http://localhost
NEXTAUTH_SECRET=helix_dashboard_secret_key_change_in_production

# ------------------------------------------
# HELIX CLI System Configuration
# ------------------------------------------
HELIX_LOG_LEVEL=info
HELIX_DISABLE_TELEMETRY=true
HELIX_DEFAULT_GIT_PLATFORM=github

# ------------------------------------------
# Bot Hosted Local CLI Configuration
# Set to your own fork or custom repository URL if desired
# ------------------------------------------
HELIX_CLI_REPO_URL=https://github.com/HELIX-Origin/helix-cli.git
HELIX_CLI_DIR=.cli

