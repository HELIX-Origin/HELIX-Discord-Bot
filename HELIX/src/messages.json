{
  "errors": {
    "generic": "❌ An unexpected error occurred. Please try again later.",
    "permission_denied": "❌ You do not have permission to execute this command.",
    "bot_permission_denied": "❌ I lack the required Discord permissions to perform this action.",
    "command_not_found": "❌ Command not found. Use `{prefix}help` to view available commands.",
    "subcommand_not_found": "❌ Subcommand not found. Use `{prefix}help` for usage.",
    "missing_argument": "❌ Missing required argument: `{arg}`",
    "invalid_argument": "❌ Invalid value for `{arg}`: `{value}`",
    "invalid_user": "❌ Could not find user: `{input}`",
    "invalid_channel": "❌ Could not find channel: `{input}`",
    "invalid_role": "❌ Could not find role: `{input}`",
    "invalid_duration": "❌ Invalid duration format. Use formats like `10m`, `1h`, `7d`.",
    "duration_too_long": "❌ Duration exceeds maximum allowed limit of `{max}`.",
    "guild_only": "❌ This command can only be used within a Discord server.",
    "dm_only": "❌ This command can only be used in direct messages.",
    "database_error": "❌ Database operation failed. Please try again.",
    "rate_limited": "⚠️ You are running commands too quickly. Please wait a moment.",
    "plugin_not_found": "❌ Language plugin `{name}` not found in the registry.",
    "plugin_load_failed": "❌ Failed to load plugin `{name}`: {reason}",
    "plugin_already_enabled": "ℹ️ Plugin `{name}` is already enabled.",
    "plugin_already_disabled": "ℹ️ Plugin `{name}` is already disabled.",
    "install_failed": "❌ Failed to install plugin: {reason}",
    "repo_not_found": "❌ Repository not found: `{repo}`",
    "clone_failed": "❌ Failed to clone repository: {reason}",
    "config_invalid": "❌ Invalid configuration in config.json: {errors}",
    "manifest_invalid": "❌ Invalid plugin manifest in plugin.json: {errors}",
    "no_plugins_loaded": "ℹ️ No language plugins are currently registered.",
    "unsupported_language": "❌ Language `{lang}` is not supported by any registered plugin."
  },
  "moderation": {
    "ban": {
      "embed": {
        "title": "🔨 Member Banned",
        "color": "#ff4444",
        "fields": [
          { "name": "Target", "value": "{target}", "inline": true },
          { "name": "Moderator", "value": "<@{moderatorId}>", "inline": true },
          { "name": "Reason", "value": "{reason}", "inline": false }
        ]
      },
      "not_found": "❌ Target user not found.",
      "cannot_ban": "❌ I cannot ban this user due to role hierarchy or permissions."
    },
    "kick": {
      "embed": {
        "title": "👢 Member Kicked",
        "color": "#ff7744",
        "fields": [
          { "name": "Target", "value": "{target}", "inline": true },
          { "name": "Moderator", "value": "<@{moderatorId}>", "inline": true },
          { "name": "Reason", "value": "{reason}", "inline": false }
        ]
      },
      "not_found": "❌ Target user not found.",
      "cannot_kick": "❌ I cannot kick this user due to role hierarchy or permissions."
    },
    "unban": {
      "embed": {
        "title": "🔓 Member Unbanned",
        "color": "#00e676",
        "fields": [
          { "name": "User ID", "value": "`{userId}`", "inline": true },
          { "name": "Moderator", "value": "<@{moderatorId}>", "inline": true },
          { "name": "Reason", "value": "{reason}", "inline": false }
        ]
      },
      "failed": "❌ Failed to unban user: {reason}"
    },
    "timeout": {
      "embed": {
        "title": "⏱️ Member Timed Out",
        "color": "#ffaa00",
        "fields": [
          { "name": "Target", "value": "{target}", "inline": true },
          { "name": "Duration", "value": "{minutes} minute(s)", "inline": true },
          { "name": "Reason", "value": "{reason}", "inline": false }
        ]
      },
      "cannot_timeout": "❌ Cannot timeout this member."
    },
    "untimeout": {
      "embed": {
        "title": "⏱️ Timeout Removed",
        "color": "#00e676",
        "fields": [
          { "name": "Target", "value": "{target}", "inline": true },
          { "name": "Reason", "value": "{reason}", "inline": false }
        ]
      }
    },
    "purge": {
      "embed": {
        "title": "🧹 Messages Purged",
        "color": "#00d2ff",
        "description": "Successfully purged **{count}** message(s) from this channel."
      },
      "failed": "❌ Failed to purge messages: {reason}"
    },
    "warn": {
      "warn_embed": {
        "title": "⚠️ Member Warned",
        "color": "#ffaa00",
        "fields": [
          { "name": "Target", "value": "{target}", "inline": true },
          { "name": "Moderator", "value": "<@{moderatorId}>", "inline": true },
          { "name": "Reason", "value": "{reason}", "inline": false }
        ]
      },
      "list_embed": {
        "title": "📋 Warnings for {target}",
        "color": "#ffaa00",
        "description": "{warningsList}"
      },
      "clear_embed": {
        "title": "🧹 Warnings Cleared",
        "color": "#00e676",
        "description": "Cleared **{count}** warning(s) for {target}."
      },
      "no_warnings": "ℹ️ No warnings recorded for {target}."
    }
  },
  "utility": {
    "ping": {
      "embed": {
        "title": "🏓 Pong!",
        "color": "#00d2ff",
        "fields": [
          { "name": "Gateway Ping", "value": "`{gateway}ms`", "inline": true },
          { "name": "Bot Uptime", "value": "`{uptime}`", "inline": true }
        ]
      }
    },
    "avatar": {
      "embed": {
        "title": "🖼️ Avatar for {target}",
        "color": "#00d2ff",
        "description": "[Click here to view full image]({url})"
      }
    },
    "serverinfo": {
      "embed": {
        "title": "📊 Server Information — {name}",
        "color": "#00d2ff",
        "fields": [
          { "name": "Server ID", "value": "`{id}`", "inline": true },
          { "name": "Owner", "value": "<@{ownerId}>", "inline": true },
          { "name": "Members", "value": "{memberCount}", "inline": true },
          { "name": "Channels", "value": "{channelCount}", "inline": true },
          { "name": "Roles", "value": "{roleCount}", "inline": true },
          { "name": "Created", "value": "{createdAt}", "inline": true }
        ]
      }
    },
    "userinfo": {
      "embed": {
        "title": "👤 User Information — {username}",
        "color": "#00d2ff",
        "fields": [
          { "name": "User ID", "value": "`{id}`", "inline": true },
          { "name": "Account Created", "value": "{createdAt}", "inline": true },
          { "name": "Joined Server", "value": "{joinedAt}", "inline": true },
          { "name": "Roles ({roleCount})", "value": "{roles}", "inline": false }
        ]
      }
    },
    "poll": {
      "embed": {
        "title": "📊 Poll: {question}",
        "color": "#00d2ff",
        "description": "{optionsText}\n\n*React below to cast your vote!*"
      }
    },
    "snowflake": {
      "embed": {
        "title": "❄️ Snowflake Decoder — {id}",
        "color": "#00d2ff",
        "fields": [
          { "name": "Timestamp", "value": "{timestamp}", "inline": true },
          { "name": "Worker ID", "value": "`{workerId}`", "inline": true },
          { "name": "Process ID", "value": "`{processId}`", "inline": true }
        ]
      }
    },
    "remind": {
      "embed": {
        "title": "⏰ Reminder Scheduled",
        "color": "#00d2ff",
        "description": "I will remind you in **{duration}**:\n\n> {message}"
      }
    }
  },
  "info": {
    "help": {
      "embed": {
        "title": "📖 HELIX Commands",
        "color": "#00d2ff",
        "description": "Use `{prefix}<command>` or `/<command>` to run any command.",
        "footer": "{count} commands across {categories} categories"
      }
    },
    "info": {
      "embed": {
        "title": "🧬 HELIX Bot Information",
        "color": "#00d2ff",
        "fields": [
          { "name": "Bot Version", "value": "`v{version}`", "inline": true },
          { "name": "Node.js", "value": "`{nodeVersion}`", "inline": true },
          { "name": "discord.js", "value": "`v{djsVersion}`", "inline": true },
          { "name": "Uptime", "value": "{uptime}", "inline": true },
          { "name": "Connected Guilds", "value": "{guildCount}", "inline": true },
          { "name": "Memory Usage", "value": "{memoryUsed} MB / {memoryTotal} MB", "inline": true }
        ]
      }
    },
    "status": {
      "embed": {
        "title": "💚 HELIX System Health",
        "color": "#00e676",
        "fields": [
          { "name": "Gateway Ping", "value": "`{gateway}ms`", "inline": true },
          { "name": "SQLite DB", "value": "`{dbSize} KB` (in-process)", "inline": true },
          { "name": "Guilds", "value": "{guildCount}", "inline": true },
          { "name": "Tickets", "value": "{ticketCount}", "inline": true },
          { "name": "Scaffolds", "value": "{scaffoldCount}", "inline": true },
          { "name": "Warnings", "value": "{warningCount}", "inline": true }
        ]
      }
    },
    "list": {
      "embed": {
        "title": "📁 Project Scaffolding Templates",
        "color": "#651fff",
        "description": "Use `{prefix}create <template> <name>` to scaffold a project.\n\n{templatesList}"
      }
    },
    "lint": {
      "clean_embed": {
        "title": "✨ Code Diagnostics Clean — {language}",
        "color": "#00e676",
        "description": "No errors, warnings, or anti-patterns detected in the provided code snippet."
      },
      "issues_embed": {
        "title": "🔍 Code Diagnostics — {language}",
        "color": "#ffaa00",
        "description": "Found **{errors}** error(s), **{warnings}** warning(s), **{info}** suggestion(s):\n\n{issuesList}"
      }
    },
    "explain": {
      "embed": {
        "title": "📖 Code Breakdown — {language}",
        "color": "#00d2ff",
        "description": "{summary}\n\n{explanationsList}"
      }
    },
    "docs": {
      "embed": {
        "title": "📚 Official Documentation — {topic}",
        "color": "#00d2ff",
        "description": "{summary}",
        "fields": [
          { "name": "Official Guide", "value": "[Click to Read Online]({url})", "inline": false }
        ]
      },
      "not_found": "ℹ️ No documentation references found for topic `{topic}` in `{language}`."
    },
    "debug": {
      "embed": {
        "title": "🛠️ Error Diagnostics — {errorType}",
        "color": "#ff334b",
        "description": "❌ **{errorMessage}**\n\n**🔍 Root Cause:**\n{rootCause}\n\n**💡 Recommended Solution:**\n{suggestedFix}"
      }
    },
    "generate": {
      "embed": {
        "title": "⚡ Code Generator — {name} ({language})",
        "color": "#00e676",
        "description": "Generated **{snippetType}** for `{name}`:\n\n{description}"
      }
    },
    "refactor": {
      "embed": {
        "title": "🔨 Code Modernization & Refactor — {language}",
        "color": "#00d2ff",
        "description": "📊 **{diffSummary}**\n\n{transformationsList}"
      }
    },
    "inspect": {
      "clean_embed": {
        "title": "🛡️ Security Audit Passed — {language}",
        "color": "#00e676",
        "description": "Security Score: **100 / 100 (A+)** ✨\n\nNo security vulnerabilities, hardcoded secrets, injection vectors, or hazardous anti-patterns detected in source code."
      },
      "issues_embed": {
        "title": "🛡️ Security & Anti-Pattern Audit — {language}",
        "color": "#ff334b",
        "description": "Security Score: **{score} / 100**\nCritical: **{critical}** · High: **{high}** · Medium: **{medium}** · Low: **{low}**\n\n{findingsList}"
      }
    }
  },
  "project": {
    "create": {
      "embed": {
        "title": "🚀 Project Scaffolding: {name}",
        "color": "#651fff",
        "description": "Successfully scaffolded template **{template}** at `./{name}`.",
        "fields": [
          { "name": "Template ID", "value": "`{template}`", "inline": true },
          { "name": "Files Generated", "value": "{fileCount}", "inline": true }
        ]
      },
      "failed": "❌ Failed to scaffold project: {reason}"
    },
    "scaffold": {
      "embed": {
        "title": "📁 Template Blueprint: {type}",
        "color": "#651fff",
        "description": "Blueprint structure for **{type}**:\n```\n{tree}\n```"
      },
      "invalid_type": "❌ Unknown template type `{type}`. Use `{prefix}list` to see valid options."
    }
  },
  "config": {
    "set": {
      "embed_success": {
        "title": "⚙️ Server Configuration Updated",
        "color": "#00d2ff",
        "description": "Successfully updated **{setting}** to {value}."
      },
      "embed_view": {
        "title": "⚙️ Server Configuration",
        "color": "#00d2ff",
        "fields": [
          { "name": "Command Prefix", "value": "`{prefix}`", "inline": true },
          { "name": "Tickets Hub", "value": "{ticketsHub}", "inline": true },
          { "name": "Manager Role", "value": "{managerRole}", "inline": true },
          { "name": "Mod Log Channel", "value": "{modLog}", "inline": true },
          { "name": "Welcome Channel", "value": "{welcome}", "inline": true },
          { "name": "Slash Categories", "value": "{slashCategories}", "inline": true }
        ]
      },
      "embed_slash_updated": {
        "title": "⚡ Slash Commands Updated",
        "color": "#00d2ff",
        "description": "{description}"
      }
    },
    "ticket": {
      "hub_embed": {
        "title": "🎫 HELIX Support & Ticket Hub",
        "color": "#7c4dff",
        "description": "Welcome to Support! If you need assistance, wish to report an issue, or have questions for our staff, click the button below to open a private ticket thread.",
        "fields": [
          { "name": "Private & Secure", "value": "Only you and Ticket Managers have access.", "inline": true },
          { "name": "Fast Response", "value": "Staff is alerted immediately upon opening.", "inline": true }
        ],
        "footer": "HELIX Support Suite • Thread-Based Architecture"
      },
      "welcome_embed": {
        "title": "🎫 Ticket: {subject}",
        "color": "#7c4dff",
        "description": "Welcome <@{userId}>! {staffMention} will be with you shortly.\n\nPlease describe your request in detail. When resolved, click **Close Ticket** below.",
        "fields": [
          { "name": "Opened By", "value": "<@{userId}>", "inline": true },
          { "name": "Status", "value": "`🟢 Open`", "inline": true },
          { "name": "Topic", "value": "{subject}", "inline": false }
        ],
        "footer": "HELIX Support Suite • Thread-Based Architecture"
      },
      "closed_embed": {
        "title": "🔒 Ticket Closed",
        "color": "#ff4444",
        "description": "This ticket has been closed by <@{closedBy}>.\n\nThis thread is now locked and archived."
      }
    },
    "plugin": {
      "list_embed": {
        "title": "🧩 Installed Language Plugins",
        "color": "#00e5ff",
        "description": "{pluginsList}"
      },
      "info_embed": {
        "title": "🧩 Plugin Details — {name}",
        "color": "#00e5ff",
        "fields": [
          { "name": "Plugin ID", "value": "`{id}`", "inline": true },
          { "name": "Version", "value": "`v{version}`", "inline": true },
          { "name": "Author", "value": "{author}", "inline": true },
          { "name": "File Extensions", "value": "`{extensions}`", "inline": true },
          { "name": "Capabilities", "value": "{capabilities}", "inline": false },
          { "name": "Description", "value": "{description}", "inline": false }
        ]
      },
      "install_embed": {
        "title": "📦 Installing Plugin",
        "color": "#00e5ff",
        "description": "Fetching repository `{repo}` into database plugin registry..."
      },
      "install_success_embed": {
        "title": "✅ Plugin Installed",
        "color": "#00e676",
        "description": "Successfully installed `{count}` plugin(s) from `{repo}` into database registry."
      },
      "remove_success": "🗑️ Successfully removed plugin `{id}`.",
      "enable_success": "✅ Enabled language plugin `{id}`.",
      "disable_success": "⏸️ Disabled language plugin `{id}`.",
      "repo_list_embed": {
        "title": "📦 Configured Plugin Repositories",
        "color": "#00e5ff",
        "description": "{reposList}"
      },
      "repo_remove_success": "🗑️ Successfully removed repository `{repo}`."
    }
